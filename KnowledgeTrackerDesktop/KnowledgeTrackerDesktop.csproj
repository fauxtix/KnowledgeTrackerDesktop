<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- RID used by the MSIX packaging project (self-contained win-x64). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Release metadata -->
    <Product>KnowledgeTracker</Product>
    <Company>KnowledgeTracker</Company>
    <Authors>fauxtix</Authors>
    <Copyright>Copyright © 2026 fauxtix</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!--
    The Syncfusion license key is injected at build time from the
    SYNCFUSION_LICENSE_KEY environment variable and stored as assembly
    metadata, so published builds start without requiring an environment
    variable on the target machine. The key is never committed to the
    repository. When the variable is not set, no metadata is emitted and the
    app falls back to the environment variable at runtime.
  -->
  <ItemGroup Condition="'$(SYNCFUSION_LICENSE_KEY)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SyncfusionLicenseKey</_Parameter1>
      <_Parameter2>$(SYNCFUSION_LICENSE_KEY)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnowledgeTrackerDesktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Syncfusion.Core.WinForms" Version="35.1.39" />
    <PackageReference Include="Syncfusion.Grid.Windows" Version="35.1.39" />
    <PackageReference Include="Syncfusion.Tools.Windows" Version="35.1.39" />
    <PackageReference Include="Syncfusion.SfInput.WinForms" Version="35.1.39" />
    <PackageReference Include="Syncfusion.SfListView.WinForms" Version="35.1.39" />
    <PackageReference Include="Syncfusion.Office2016Theme.WinForms" Version="35.1.39" />
    <PackageReference Include="Syncfusion.Licensing" Version="35.1.39" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\Theme\Themes\CarbonDark\*.xml">
      <LogicalName>Syncfusion.WinForms.Themes.Resources.Themes.CarbonDark.%(Filename).xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Images\portugal.png" />
    <EmbeddedResource Include="Assets\Images\Inglaterra.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="docs\Help.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="docs\Help.pt-PT.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="docs\Help.en.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>